# ============================================================================
# .env.production.example — TEMPLATE de produção (Render + Supabase + Upstash + R2)
# ============================================================================
# ATENÇÃO: este arquivo é versionado no Git. NUNCA cole valores reais aqui.
# Os secrets de produção vivem APENAS no dashboard do Render (Environment).
# Pra setup local de prod-like, copie pra `.env.production` (gitignored).
# ============================================================================

# Ambiente
ENVIRONMENT=production
SERVICE_NAME=api
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
SLOW_REQUEST_THRESHOLD_OVERRIDES=/api/v1/auth/login=2000,/api/v1/documents/upload-url=800,/api/v1/documents/confirm-upload=900
PROMETHEUS_QUEUE_NAMES=celery

# ----------------------------------------------------------------------------
# Banco de dados — Supabase (Sprint deploy / ADR pós-2026-05)
# ----------------------------------------------------------------------------
# Em prod usamos DATABASE_URL como override único (string PostgreSQL). O Alembic
# usa MIGRATE_DATABASE_URL (direta, porta 5432). A API/worker usa pooler (6543).
DATABASE_URL=postgresql://postgres.<PROJ_REF>:<DB_PASSWORD>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
MIGRATE_DATABASE_URL=postgresql://postgres.<PROJ_REF>:<DB_PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# Redis — Upstash (TLS obrigatório)
# ----------------------------------------------------------------------------
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_HOST>.upstash.io:6379?ssl_cert_reqs=CERT_REQUIRED

# ----------------------------------------------------------------------------
# Storage — Cloudflare R2 (S3-compatible)
# ----------------------------------------------------------------------------
# As variáveis MINIO_* são genéricas — boto3 fala S3 com R2 sem problema.
# O bucket `regente-docs` deve existir no R2 e ter CORS liberado pra origin
# do frontend (ver docs/DEPLOY_REGENTE.md passo c).
MINIO_SERVER=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_PUBLIC_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<r2-access-key-id>
MINIO_SECRET_KEY=<r2-secret-access-key>
MINIO_SECURE=True

# ----------------------------------------------------------------------------
# JWT / Segurança
# ----------------------------------------------------------------------------
SECRET_KEY=<gere-uma-chave-com-pelo-menos-32-caracteres>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# E-mail — Resend (SMTP relay)
# ----------------------------------------------------------------------------
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=<resend-api-key-aqui>
EMAILS_FROM_EMAIL=noreply@regenteambiental.com.br
EMAILS_FROM_NAME=Regente Ambiental
RESEND_API_KEY=<resend-api-key-aqui>
RESEND_AUDIENCE_ID=<resend-audience-uuid>
RESEND_FROM_EMAIL=noreply@regenteambiental.com.br

# ----------------------------------------------------------------------------
# URLs públicas
# ----------------------------------------------------------------------------
CLIENT_PORTAL_URL=https://portal.regenteambiental.com.br/dashboard
BACKEND_CORS_ORIGINS=https://app.regenteambiental.com.br,https://portal.regenteambiental.com.br
API_BACKEND_URL=https://regente-api.onrender.com

# ----------------------------------------------------------------------------
# Observabilidade
# ----------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=2.0
ALERT_WEBHOOK_AUTH_HEADER=Authorization
ALERT_WEBHOOK_AUTH_TOKEN=Bearer <webhook-token>
ALERT_WEBHOOK_SIGNING_SECRET=<hmac-secret>
ALERT_WEBHOOK_MIN_SEVERITY=error

# ----------------------------------------------------------------------------
# IA / LLM
# ----------------------------------------------------------------------------
AI_ENABLED=true
OPENAI_API_KEY=<sk-proj-...>
GEMINI_API_KEY=<google-api-key>
ANTHROPIC_API_KEY=<sk-ant-api03-...>
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gemini/gemini-1.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30.0
AI_MAX_COST_PER_JOB_USD=0.10
