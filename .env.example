# ============================================================================
# Regente Ambiental — .env.example
# ============================================================================
# Copie pra .env e preencha. NUNCA commite o .env real.
#
# Layout: variáveis de DEV em primeiro lugar; vars exclusivas de DEPLOY no
# bloco "Deploy (Render + Supabase + R2 + Upstash)" no final.
# ============================================================================

# ----------------------------------------------------------------------------
# Ambiente
# ----------------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
SERVICE_NAME=api                 # "api" no web, "worker" no Celery
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
SLOW_REQUEST_THRESHOLD_OVERRIDES=/api/v1/auth/login=2000,/api/v1/documents/upload-url=800,/api/v1/documents/confirm-upload=900

# ----------------------------------------------------------------------------
# Alert webhook (operational alerts → Slack/PagerDuty etc.)
# Em dev, deixar URL vazia desativa o webhook (worker não retry-loop).
# ----------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=2.0
ALERT_WEBHOOK_AUTH_HEADER=Authorization
ALERT_WEBHOOK_AUTH_TOKEN=
ALERT_WEBHOOK_SIGNING_SECRET=
ALERT_WEBHOOK_MIN_SEVERITY=error      # info | warning | error | critical
PROMETHEUS_QUEUE_NAMES=celery

# ----------------------------------------------------------------------------
# Banco de dados
# ----------------------------------------------------------------------------
# Em DEV (compose): o api/worker conectam internamente em db:5432.
# Do venv host (alembic local, scripts ops): aponte para 127.0.0.1:55432.
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=amigao_db
POSTGRES_PORT=55432

# DATABASE_URL: single-string override usado em deploy (Render/Supabase).
# Quando setado, tem precedência sobre POSTGRES_* na composição da URI.
# Em DEV deixe vazio — o Settings monta a URI a partir dos POSTGRES_*.
# Em PROD (Supabase Transaction Pooler):
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# MIGRATE_DATABASE_URL: usado SÓ pelo alembic. Aponta pra Supabase direct
# (porta 5432), não pelo pooler (DDL exige sessão estável).
# Em PROD:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Em DEV: deixar vazio (alembic cai no SQLALCHEMY_DATABASE_URI normal).
MIGRATE_DATABASE_URL=

# ----------------------------------------------------------------------------
# Redis (broker Celery + cache realtime events)
# ----------------------------------------------------------------------------
# DEV: redis local sem TLS. PROD (Upstash): use rediss:// (TLS).
#   rediss://default:<password>@<region>.upstash.io:6379
# O app normaliza o param ssl_cert_reqs (aceita CERT_REQUIRED/required/etc. e
# converte pro token que o redis-py espera) — não precisa anexar nada à URL.
REDIS_URL=redis://localhost:6379/0
REALTIME_EVENTS_CHANNEL=amigao_events

# ----------------------------------------------------------------------------
# Storage S3-compatible (DEV: MinIO local | PROD: Cloudflare R2)
# ----------------------------------------------------------------------------
# As variáveis MINIO_* são genéricas — o boto3 fala S3 com R2 sem problema.
# DEV (MinIO):  MINIO_SERVER=localhost:9000, MINIO_SECURE=False
# PROD (R2):    MINIO_SERVER=<acct>.r2.cloudflarestorage.com, MINIO_SECURE=True
#               MINIO_PUBLIC_URL=https://<acct>.r2.cloudflarestorage.com (mesmo valor)
#               Credenciais geradas no R2 dashboard (Access Key + Secret Key).
MINIO_SERVER=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
# Region do cliente S3. Cloudflare R2 EXIGE "auto" (com "us-east-1" o GET
# server-side dá SignatureDoesNotMatch). MinIO ignora — "auto" é o default e
# serve para os dois. Só mude se usar um S3 real que exija region específica.
S3_REGION=auto

# ----------------------------------------------------------------------------
# JWT / Auth
# ----------------------------------------------------------------------------
# SECRET_KEY: mínimo 32 caracteres. Gerar com `openssl rand -hex 32`.
# Em produção, NUNCA reutilizar a chave de dev.
SECRET_KEY=defina-uma-chave-com-pelo-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------------------------------------------------------------
# Cripto de segredos (ADR-014 — Frente D)
# ----------------------------------------------------------------------------
# Chave Fernet OBRIGATÓRIA, separada do SECRET_KEY do JWT. App falha no startup
# se não estiver setada. Gerar com `python tools/gen_encryption_key.py`.
CREDENTIAL_ENCRYPTION_KEY=<gerar com tools/gen_encryption_key.py>
# Chave antiga durante rotação (MultiFernet). Deixar vazia fora de rotação.
# CREDENTIAL_ENCRYPTION_KEY_OLD=

# ----------------------------------------------------------------------------
# SMTP (emails transacionais do portal interno)
# ----------------------------------------------------------------------------
# Em DEV: Mailtrap sandbox (default). Em PROD: smtp_configured tem que ser
# True ou o boot falha. Use provider com SPF/DKIM (Resend, SendGrid, etc.).
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@regenteambiental.com.br
EMAILS_FROM_NAME=Regente Ambiental

# ----------------------------------------------------------------------------
# Resend (Sprint B1 — waitlist público)
# ----------------------------------------------------------------------------
# Obrigatório em produção (validate_security falha-rápido sem RESEND_API_KEY).
# Em dev, vazio = skip silencioso no client.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=contato@regenteambiental.com.br
RESEND_FROM_NAME=Regente Ambiental

# ----------------------------------------------------------------------------
# Canal de mensagens — WhatsApp (PR 2.1)
# ----------------------------------------------------------------------------
# Integra canal a CASO JÁ ABERTO (mensagens inbound NÃO criam caso). DORMENTE
# por default: deixe EVOLUTION_API_URL/KEY vazios e o canal fica inativo.
# Para ativar a instância Evolution dedicada do docker-compose:
#   docker compose --profile whatsapp up -d evolution
#   (crie o database `evolution` no Postgres e pareie o número via QR no Manager)
# Depois preencha abaixo e parei o número. Provider plugável: 'evolution' | 'zapi'.
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_HOST_PORT=8080
# Z-API — placeholders (provider em STUB, não implementado nesta PR)
ZAPI_API_URL=
ZAPI_API_KEY=
ZAPI_WEBHOOK_SECRET=
# E-mail inbound — NÃO implementado nesta PR (Resend Inbound não habilitado).
# Placeholders para quando o domínio/plano habilitar (MX apontando ao Resend).
EMAIL_INBOUND_PROVIDER=
RESEND_INBOUND_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Seed local / homologação
# ----------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=Seed@2026
SEED_CONSULTANT_PASSWORD=Seed@2026
SEED_CLIENT_PASSWORD=Seed@2026
SEED_FIELD_PASSWORD=Seed@2026
SEED_RESET_PASSWORDS=false

# ----------------------------------------------------------------------------
# URLs e CORS
# ----------------------------------------------------------------------------
# Em PROD: apontar para o painel consultor real (Vite build).
CLIENT_PORTAL_URL=http://localhost:3000/dashboard

# BACKEND_CORS_ORIGINS: lista CSV. Em prod NÃO pode ter localhost (validator
# falha-rápido). Para o piloto: app + raiz + www do domínio principal.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# Usado pelo client-portal (Next.js) pra falar com a API via compose network.
API_BACKEND_URL=http://api:8000

# ----------------------------------------------------------------------------
# IA / LLM (Wave 2 — Sprint 5)
# ----------------------------------------------------------------------------
# Habilitar: AI_ENABLED=true + pelo menos uma chave abaixo.
AI_ENABLED=false

# OpenAI — https://platform.openai.com/api-keys (formato: sk-proj-...)
OPENAI_API_KEY=
# Gemini — https://aistudio.google.com/apikey (formato: AIza...)
# Obrigatório se LEGISLATION_USE_GEMINI_DEFAULT=true.
GEMINI_API_KEY=
# Anthropic — https://console.anthropic.com/settings/keys (formato: sk-ant-api03-...)
ANTHROPIC_API_KEY=

# Embedding provider: "openai" | "gemini" | vazio (auto-detecta).
# ATENÇÃO: trocar exige re-embedar TODO o corpus — vetores entre providers
# são incompatíveis. Decisão atual: openai text-embedding-3-small @ 768 dims.
EMBEDDING_PROVIDER=

# Defaults gerais de LLM (sobrescritos por agente quando faz sentido).
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gemini/gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30.0

# Cost guards (USD). 0 = ilimitado.
AI_MAX_COST_PER_JOB_USD=0.10
AI_BUDGET_USD_MONTHLY_PER_TENANT_DEFAULT=0.0

# ----------------------------------------------------------------------------
# Agente legislação (RAG + Gemini routing)
# ----------------------------------------------------------------------------
LEGISLATION_USE_GEMINI_DEFAULT=true
LEGISLATION_MAX_CONTEXT_TOKENS=900000
LEGISLATION_MAX_CONTEXT_TOKENS_LONG=1900000
LEGISLATION_MAX_RESULTS=20
LEGISLATION_RAG_TOP_K=8

# Claude (fallback do agente regulatório se Gemini não estiver configurado)
CLAUDE_LEGAL_MODEL=claude-sonnet-4-20250514
CLAUDE_LEGAL_MAX_TOKENS=8192
CLAUDE_LEGAL_TEMPERATURE=0.1

# Gemini routing (Flash → Pro quando contexto > threshold)
GEMINI_LEGAL_MODEL=gemini/gemini-2.5-flash
GEMINI_LEGAL_LONG_MODEL=gemini/gemini-2.5-pro
GEMINI_LEGAL_LONG_CONTEXT_THRESHOLD_CHARS=3200000

# Modelo Gemini Vision do pipeline de OCR (PDFs escaneados).
# Quando o Google descontinuar o modelo, troque AQUI (env), não no código.
GEMINI_OCR_MODEL=gemini/gemini-2.5-flash

# Cost guards específicos do agente legislação
AI_MAX_COST_PER_JOB_USD_LEGISLACAO=0.30
AI_MAX_COST_PER_JOB_USD_LEGISLACAO_LONG=5.00

# ---------------------------------------------------------------------------
# Transcrição de áudio de reunião (dívida #103 · ADR-060)
# ---------------------------------------------------------------------------
# Modelo de transcrição. Entre os providers suportados, só a OpenAI expõe
# endpoint de transcrição — sem OPENAI_API_KEY a transcrição falha com mensagem
# explícita, sem cair em fallback silencioso (dívida #202). Quando o provedor
# descontinuar o modelo, troque AQUI (env), não no código.
AUDIO_TRANSCRIPTION_MODEL=whisper-1
# Preço de tabela do modelo acima, USD por MINUTO de áudio. O litellm não
# precifica transcrição; é este número que sustenta o custo no AIJob e a soma do
# teto mensal do tenant. whisper-1 = $0.006/min ⇒ reunião de 30 min ≈ $0.18.
AUDIO_TRANSCRIPTION_USD_PER_MINUTE=0.006
# Teto de tamanho aceito pelo provedor (a OpenAI recusa acima de 25 MB). Acima
# disso a task falha com motivo acionável ANTES de gastar a chamada (dívida #201).
AUDIO_TRANSCRIPTION_MAX_BYTES=26214400
AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=300.0
AI_MAX_COST_PER_JOB_USD_TRANSCRICAO=1.00
# Idioma dominante das reuniões. Vazio = detecção automática.
AUDIO_TRANSCRIPTION_LANGUAGE=pt
# Gancho do resumo estruturado (decisão 3a da Isis — pendente). Ligado, roda uma
# chamada extra sobre a transcrição pronta e prefixa ao texto um bloco com o que
# o cliente pediu, o que prometeu enviar, prazos e decisões. Ver dívida #203.
AUDIO_TRANSCRICAO_RESUMO_ENABLED=false

# ============================================================================
# Bloco DEPLOY-ONLY (Render dashboard / envVarGroups)
# ============================================================================
# As variáveis abaixo NÃO existem no Settings — são lidas direto pelo runtime
# do Render ou pelo Docker compose override. Documentadas aqui pra inventário.
#
# Não preencha em dev — vivem no Render dashboard como envVarGroup secret.
# ============================================================================
#
# DOCKER_POSTGRES_SERVER=    # default "db" — só faz sentido em compose
# DOCKER_POSTGRES_PORT=      # default "5432" — só faz sentido em compose
# DOCKER_REDIS_URL=          # default redis://:redispass2026@redis:6379/0 — compose
# DOCKER_MINIO_SERVER=       # default minio:9000 — compose
# HOST_DB_PORT=              # default 55432 — porta exposta do db do compose pro host
# REDIS_PASSWORD=            # default redispass2026 — só compose, não usado pelo app
